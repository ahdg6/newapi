+)
+
+func TestDSHOIDCConcurrentFirstLoginKeepsOneBinding(t *testing.T) {
+	previousDB, previousLogDB := DB, LOG_DB
+	previousRegister, previousQuota := common.RegisterEnabled, common.QuotaForNewUser
+	common.RegisterEnabled, common.QuotaForNewUser = true, 0
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "dsh-oidc.db")), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&User{}, &ExternalIdentityClaim{}, &Log{}))
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(4)
+	DB, LOG_DB = db, db
+	t.Cleanup(func() {
+		DB, LOG_DB = previousDB, previousLogDB
+		common.RegisterEnabled, common.QuotaForNewUser = previousRegister, previousQuota
+		_ = sqlDB.Close()
+	})
+
+	const callers = 4
+	start := make(chan struct{})
+	results := make([]*User, callers)
+	errors := make([]error, callers)
+	var workers sync.WaitGroup
+	workers.Add(callers)
+	for i := range results {
+		go func(index int) {
+			defer workers.Done()
+			<-start
+			results[index], errors[index] = FindOrCreateDSHOIDCUser("one-subject", true, DSHOIDCProfile{Username: "zitadel-user", DisplayName: "Zitadel User", Email: "user@example.test"})
+		}(i)
+	}
+	close(start)
+	workers.Wait()
+
+	var userCount, claimCount int64
+	require.NoError(t, db.Model(&User{}).Where("oidc_id = ?", "one-subject").Count(&userCount).Error)
+	require.NoError(t, db.Model(&ExternalIdentityClaim{}).Where("provider = ? AND subject = ?", "dsh_oidc", "one-subject").Count(&claimCount).Error)
+	assert.EqualValues(t, 1, userCount)
+	assert.EqualValues(t, 1, claimCount)
+	var successful int
+	for i := range results {
+		if errors[i] == nil {
+			successful++
+			assert.NotZero(t, results[i].Id)
+		}
+	}
+	assert.Positive(t, successful)
+	resolved, err := FindOrCreateDSHOIDCUser("one-subject", true, DSHOIDCProfile{Username: "zitadel-user", DisplayName: "Zitadel User", Email: "user@example.test"})
+	require.NoError(t, err)
+	assert.Equal(t, "zitadel-user", resolved.Username)
+	assert.Equal(t, "Zitadel User", resolved.DisplayName)
+	assert.Equal(t, "user@example.test", resolved.Email)
+	for i := range results {
+		if errors[i] == nil {
+			assert.Equal(t, resolved.Id, results[i].Id)
+		}
+	}
+
+}
