+package middleware
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/gin-gonic/gin"
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDSHOIDCUserAuthAndJITProvisioning(t *testing.T) {
+	setupDashboardAuthMiddlewareTest(t)
+	require.NoError(t, model.DB.AutoMigrate(&model.ExternalIdentityClaim{}))
+	previousRegisterEnabled := common.RegisterEnabled
+	common.RegisterEnabled = true
+	t.Cleanup(func() { common.RegisterEnabled = previousRegisterEnabled })
+	previousOIDCEnabled := system_setting.GetOIDCSettings().Enabled
+	previousUserInfoEndpoint := system_setting.GetOIDCSettings().UserInfoEndpoint
+	system_setting.GetOIDCSettings().Enabled = true
+	t.Cleanup(func() {
+		system_setting.GetOIDCSettings().Enabled = previousOIDCEnabled
+		system_setting.GetOIDCSettings().UserInfoEndpoint = previousUserInfoEndpoint
+	})
+	userInfo := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw := r.Header.Get("Authorization")
+		if len(raw) < 8 || raw[:7] != "Bearer " {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		parsed, _, err := jwt.NewParser().ParseUnverified(raw[7:], jwt.MapClaims{})
+		if err != nil {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		sub := parsed.Claims.(jwt.MapClaims)["sub"]
+		if sub == "mismatch-subject" {
+			sub = "another-subject"
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"sub": sub, "preferred_username": "zitadel-test", "name": "Zitadel Test", "email": "test@example.test"})
+	}))
+	t.Cleanup(userInfo.Close)
+	system_setting.GetOIDCSettings().UserInfoEndpoint = userInfo.URL
+	t.Setenv("DSH_OIDC_ISSUER", "https://zitadel.example.test")
+	t.Setenv("DSH_OIDC_AUDIENCE", "new-api-project")
+	t.Setenv("DSH_OIDC_CLIENT_ID", "dsh-native-client")
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	dshOIDCVerifier.Lock()
+	dshOIDCVerifier.verifier = oidc.NewVerifier("https://zitadel.example.test", &oidc.StaticKeySet{PublicKeys: []crypto.PublicKey{&key.PublicKey}}, &oidc.Config{ClientID: "new-api-project", SupportedSigningAlgs: []string{oidc.RS256}})
+	dshOIDCVerifier.Unlock()
+	t.Cleanup(func() {
+		dshOIDCVerifier.Lock()
+		dshOIDCVerifier.verifier = nil
+		dshOIDCVerifier.Unlock()
+	})
+
+	user := createMiddlewarePATUser(t, "zitadel-bound", "opaque.key.with-dots")
+	require.NoError(t, model.DB.Model(user).Update("oidc_id", "stable-subject").Error)
+	router := gin.New()
+	router.GET("/self", UserAuth(), func(c *gin.Context) {
+		c.JSON(http.StatusOK, gin.H{"id": c.GetInt("id"), "pat_like": c.GetBool("use_access_token")})
+	})
+	issue := func(k *rsa.PrivateKey, sub, aud, client string, expiry time.Time) string {
+		claims := jwt.MapClaims{"iss": "https://zitadel.example.test", "sub": sub, "aud": aud, "client_id": client, "exp": expiry.Unix(), "iat": time.Now().Add(-time.Minute).Unix()}
+		raw, signErr := jwt.NewWithClaims(jwt.SigningMethodRS256, claims).SignedString(k)
+		require.NoError(t, signErr)
+		return raw
+	}
+	otherKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	now := time.Now().Add(time.Hour)
+	cases := []struct {
+		name   string
+		token  string
+		status int
+	}{
+		{"valid", issue(key, "stable-subject", "new-api-project", "dsh-native-client", now), http.StatusOK},
+		{"wrong audience", issue(key, "stable-subject", "other-project", "dsh-native-client", now), http.StatusUnauthorized},
+		{"wrong client", issue(key, "stable-subject", "new-api-project", "other-client", now), http.StatusUnauthorized},
+		{"unbound subject", issue(key, "other-subject", "new-api-project", "dsh-native-client", now), http.StatusUnauthorized},
+		{"expired", issue(key, "stable-subject", "new-api-project", "dsh-native-client", time.Now().Add(-time.Minute)), http.StatusUnauthorized},
+		{"bad signature", issue(otherKey, "stable-subject", "new-api-project", "dsh-native-client", now), http.StatusUnauthorized},
+		{"opaque dotted PAT", "opaque.key.with-dots", http.StatusOK},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			request := httptest.NewRequest(http.MethodGet, "/self", nil)
+			request.Header.Set("Authorization", "Bearer "+tc.token)
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			assert.Equal(t, tc.status, response.Code)
+			if tc.status == http.StatusOK {
+				assert.Contains(t, response.Body.String(), `"id":`)
+			}
+		})
+	}
+
+	require.NoError(t, model.DB.Model(user).Update("status", common.UserStatusDisabled).Error)
+	request := httptest.NewRequest(http.MethodGet, "/self", nil)
+	request.Header.Set("Authorization", "Bearer "+issue(key, "stable-subject", "new-api-project", "dsh-native-client", now))
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	assert.Equal(t, http.StatusUnauthorized, response.Code)
+
+	require.NoError(t, model.DB.Model(user).Updates(map[string]any{"status": common.UserStatusEnabled, "role": common.RoleAdminUser}).Error)
+	adminRouter := gin.New()
+	adminRouter.GET("/admin", AdminAuth(), func(c *gin.Context) { c.Status(http.StatusNoContent) })
+	adminResponse := httptest.NewRecorder()
+	adminRequest := httptest.NewRequest(http.MethodGet, "/admin", nil)
+	adminRequest.Header.Set("Authorization", request.Header.Get("Authorization"))
+	adminRouter.ServeHTTP(adminResponse, adminRequest)
+	assert.Equal(t, http.StatusUnauthorized, adminResponse.Code)
+
+	sessionRouter := gin.New()
+	sessionRouter.GET("/session-only", UserAuth(), func(c *gin.Context) {
+		if _, ok := GetSessionAuthIdentity(c); ok {
+			c.Status(http.StatusNoContent)
+			return
+		}
+		c.Status(http.StatusForbidden)
+	})
+	sessionRequest := httptest.NewRequest(http.MethodGet, "/session-only", nil)
+	sessionRequest.Header.Set("Authorization", "Bearer "+issue(key, "stable-subject", "new-api-project", "dsh-native-client", now))
+	sessionResponse := httptest.NewRecorder()
+	sessionRouter.ServeHTTP(sessionResponse, sessionRequest)
+	assert.Equal(t, http.StatusForbidden, sessionResponse.Code)
+
+	firstLogin := gin.New()
+	firstLogin.GET("/api/user/self", UserAuth(), func(c *gin.Context) {
+		c.JSON(http.StatusOK, gin.H{"id": c.GetInt("id")})
+	})
+	newToken := issue(key, "new-zitadel-subject", "new-api-project", "dsh-native-client", now)
+	for i := 0; i < 2; i++ {
+		newRequest := httptest.NewRequest(http.MethodGet, "/api/user/self", nil)
+		newRequest.Header.Set("Authorization", "Bearer "+newToken)
+		newResponse := httptest.NewRecorder()
+		firstLogin.ServeHTTP(newResponse, newRequest)
+		assert.Equal(t, http.StatusOK, newResponse.Code)
+	}
+	created, err := model.GetUserByOIDCSubject("new-zitadel-subject")
+	require.NoError(t, err)
+	assert.Equal(t, common.RoleCommonUser, created.Role)
+	assert.Equal(t, common.UserStatusEnabled, created.Status)
+	assert.Equal(t, "default", created.Group)
+	assert.Equal(t, common.QuotaForNewUser, created.Quota)
+	assert.Equal(t, "zitadel-test", created.Username)
+	assert.Equal(t, "Zitadel Test", created.DisplayName)
+	assert.Equal(t, "test@example.test", created.Email)
+	var subjectCount int64
+	require.NoError(t, model.DB.Model(&model.User{}).Where("oidc_id = ?", "new-zitadel-subject").Count(&subjectCount).Error)
+	assert.EqualValues(t, 1, subjectCount)
+	mismatchRequest := httptest.NewRequest(http.MethodGet, "/api/user/self", nil)
+	mismatchRequest.Header.Set("Authorization", "Bearer "+issue(key, "mismatch-subject", "new-api-project", "dsh-native-client", now))
+	mismatchResponse := httptest.NewRecorder()
+	firstLogin.ServeHTTP(mismatchResponse, mismatchRequest)
+	assert.Equal(t, http.StatusUnauthorized, mismatchResponse.Code)
+
+	system_setting.GetOIDCSettings().Enabled = false
+	oidcDisabledRequest := httptest.NewRequest(http.MethodGet, "/api/user/self", nil)
+	oidcDisabledRequest.Header.Set("Authorization", "Bearer "+issue(key, "oidc-disabled-subject", "new-api-project", "dsh-native-client", now))
+	oidcDisabledResponse := httptest.NewRecorder()
+	firstLogin.ServeHTTP(oidcDisabledResponse, oidcDisabledRequest)
+	assert.Equal(t, http.StatusUnauthorized, oidcDisabledResponse.Code)
+	system_setting.GetOIDCSettings().Enabled = true
+
+	common.RegisterEnabled = false
+	unboundRequest := httptest.NewRequest(http.MethodGet, "/api/user/self", nil)
+	unboundRequest.Header.Set("Authorization", "Bearer "+issue(key, "registration-disabled-subject", "new-api-project", "dsh-native-client", now))
+	unboundResponse := httptest.NewRecorder()
+	firstLogin.ServeHTTP(unboundResponse, unboundRequest)
+	assert.Equal(t, http.StatusUnauthorized, unboundResponse.Code)
+	boundRequest := httptest.NewRequest(http.MethodGet, "/api/user/self", nil)
+	boundRequest.Header.Set("Authorization", "Bearer "+newToken)
+	boundResponse := httptest.NewRecorder()
+	firstLogin.ServeHTTP(boundResponse, boundRequest)
+	assert.Equal(t, http.StatusOK, boundResponse.Code)
+}
diff --git a/model/dsh_oidc.go b/model/dsh_oidc.go
new file mode 100644
index 0000000..0dee052
--- /dev/null
+++ b/model/dsh_oidc.go
@@ -0,0 +1,124 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+var ErrOIDCSubjectUnbound = errors.New("OIDC subject is not bound")
+var ErrOIDCSubjectUnavailable = errors.New("OIDC subject binding is unavailable")
+var ErrOIDCRegistrationDisabled = errors.New("OIDC registration is disabled")
+
+type DSHOIDCProfile struct {
+	Username    string
+	DisplayName string
+	Email       string
+}
+
+// GetUserByOIDCSubject requires a single existing OIDC binding. Never map by
+// email or username; ambiguous historical bindings must fail closed.
+func GetUserByOIDCSubject(subject string) (*User, error) {
+	return getUserByOIDCSubject(DB, subject)
+}
+
+func getUserByOIDCSubject(tx *gorm.DB, subject string) (*User, error) {
+	if subject == "" || len(subject) > 128 {
+		return nil, ErrOIDCSubjectUnavailable
+	}
+	var users []User
+	if err := tx.Unscoped().Where("oidc_id = ?", subject).Limit(2).Find(&users).Error; err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrDatabase, err)
+	}
+	if len(users) == 0 {
+		return nil, ErrOIDCSubjectUnbound
+	}
+	if len(users) != 1 || users[0].DeletedAt.Valid {
+		return nil, ErrOIDCSubjectUnavailable
+	}
+	return &users[0], nil
+}
+
+// FindOrCreateDSHOIDCUser provisions only after the caller has verified the
+// access token. Its unique subject claim makes simultaneous native first logins
+// converge on one account across New API instances.
+func FindOrCreateDSHOIDCUser(subject string, allowCreate bool, profile DSHOIDCProfile) (*User, error) {
+	user, err := GetUserByOIDCSubject(subject)
+	if err == nil {
+		return user, nil
+	}
+	if !errors.Is(err, ErrOIDCSubjectUnbound) || !allowCreate {
+		return user, err
+	}
+	if profile.Email == "" {
+		return nil, ErrOIDCSubjectUnavailable
+	}
+	if !common.RegisterEnabled {
+		return nil, ErrOIDCRegistrationDisabled
+	}
+	var created *User
+	newlyCreated := false
+	err = DB.Transaction(func(tx *gorm.DB) error {
+		if existing, lookupErr := getUserByOIDCSubject(tx, subject); lookupErr == nil {
+			created = existing
+			return nil
+		} else if !errors.Is(lookupErr, ErrOIDCSubjectUnbound) {
+			return lookupErr
+		}
+		if !common.RegisterEnabled {
+			return ErrOIDCRegistrationDisabled
+		}
+		candidate := &User{
+			Username:    "oidc_" + common.GetRandomString(12),
+			DisplayName: profile.DisplayName,
+			Email:       NormalizeEmail(profile.Email),
+			OidcId:      subject,
+			Role:        common.RoleCommonUser,
+			Status:      common.UserStatusEnabled,
+		}
+		if profile.Username != "" && len(profile.Username) <= UserNameMaxLength {
+			var count int64
+			if err := tx.Unscoped().Model(&User{}).Where("username = ?", profile.Username).Count(&count).Error; err != nil {
+				return err
+			}
+			if count == 0 {
+				candidate.Username = profile.Username
+			}
+		}
+		if candidate.DisplayName == "" {
+			if profile.Username != "" {
+				candidate.DisplayName = profile.Username
+			} else {
+				candidate.DisplayName = "OIDC User"
+			}
+		}
+		if err := candidate.InsertWithTx(tx, 0); err != nil {
+			return err
+		}
+		if err := ClaimExternalIdentityWithTx(tx, "dsh_oidc", subject, candidate.Id); err != nil {
+			return err
+		}
+		created = candidate
+		newlyCreated = true
+		return nil
+	})
+	if err != nil {
+		if errors.Is(err, ErrExternalIdentityAlreadyClaimed) || strings.Contains(strings.ToLower(err.Error()), "unique") {
+			// The other transaction may have committed the same subject first.
+			if existing, lookupErr := GetUserByOIDCSubject(subject); lookupErr == nil {
+				return existing, nil
+			}
+		}
+		return nil, fmt.Errorf("%w: %v", ErrDatabase, err)
+	}
+	if created == nil {
+		return nil, ErrOIDCSubjectUnavailable
+	}
+	if newlyCreated {
+		created.FinalizeOAuthUserCreation(0)
+	}
+	return created, nil
+}
