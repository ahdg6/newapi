diff --git a/middleware/dsh_oidc.go b/middleware/dsh_oidc.go
new file mode 100644
index 0000000..a6d9e23
--- /dev/null
+++ b/middleware/dsh_oidc.go
@@ -0,0 +1,108 @@
+package middleware
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/oauth"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+	"github.com/coreos/go-oidc/v3/oidc"
+)
+
+var dshOIDCVerifier struct {
+	sync.Mutex
+	verifier *oidc.IDTokenVerifier
+}
+
+// JWT access tokens are distinct from New API's opaque dashboard PATs.
+// With the integration disabled, normal PAT handling remains unchanged.
+func isDSHOIDCToken(raw string) bool {
+	if os.Getenv("DSH_OIDC_ISSUER") == "" || strings.Count(raw, ".") != 2 {
+		return false
+	}
+	header, err := base64.RawURLEncoding.DecodeString(strings.SplitN(raw, ".", 2)[0])
+	if err != nil {
+		return false
+	}
+	var value struct {
+		Algorithm string `json:"alg"`
+	}
+	return json.Unmarshal(header, &value) == nil && value.Algorithm != ""
+}
+
+func authenticateDSHOIDCToken(ctx context.Context, raw string, allowCreate bool) (*model.UserBase, error) {
+	issuer := strings.TrimRight(os.Getenv("DSH_OIDC_ISSUER"), "/")
+	audience := os.Getenv("DSH_OIDC_AUDIENCE")
+	clientID := os.Getenv("DSH_OIDC_CLIENT_ID")
+	if issuer == "" || audience == "" || clientID == "" || !strings.HasPrefix(issuer, "https://") {
+		return nil, service.ErrAuthTokenInvalid
+	}
+
+	dshOIDCVerifier.Lock()
+	verifier := dshOIDCVerifier.verifier
+	if verifier == nil {
+		requestCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		requestCtx = oidc.ClientContext(requestCtx, &http.Client{Timeout: 5 * time.Second})
+		provider, err := oidc.NewProvider(requestCtx, issuer)
+		if err != nil {
+			dshOIDCVerifier.Unlock()
+			return nil, service.ErrAuthTokenInvalid
+		}
+		verifier = provider.Verifier(&oidc.Config{
+			ClientID:             audience,
+			SupportedSigningAlgs: []string{oidc.RS256, oidc.ES256, oidc.EdDSA},
+		})
+		dshOIDCVerifier.verifier = verifier
+	}
+	dshOIDCVerifier.Unlock()
+
+	requestCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	requestCtx = oidc.ClientContext(requestCtx, &http.Client{Timeout: 5 * time.Second})
+	token, err := verifier.Verify(requestCtx, raw)
+	if err != nil || token.Subject == "" {
+		return nil, service.ErrAuthTokenInvalid
+	}
+	// Zitadel access tokens contain client_id; ID tokens do not. Pin the
+	// native application as well as the project's API audience.
+	var claims struct {
+		ClientID string `json:"client_id"`
+	}
+	if err = token.Claims(&claims); err != nil || claims.ClientID != clientID {
+		return nil, service.ErrAuthTokenInvalid
+	}
+	if allowCreate && !system_setting.GetOIDCSettings().Enabled {
+		allowCreate = false
+	}
+	bound, lookupErr := model.GetUserByOIDCSubject(token.Subject)
+	if lookupErr == nil {
+		return model.GetUserCache(bound.Id)
+	}
+	if !errors.Is(lookupErr, model.ErrOIDCSubjectUnbound) || !allowCreate {
+		return nil, service.ErrAuthTokenInvalid
+	}
+	profile, err := (&oauth.OIDCProvider{}).GetUserInfo(requestCtx, &oauth.OAuthToken{AccessToken: raw})
+	if err != nil || profile.ProviderUserID != token.Subject {
+		return nil, service.ErrAuthTokenInvalid
+	}
+	bound, err = model.FindOrCreateDSHOIDCUser(token.Subject, allowCreate, model.DSHOIDCProfile{
+		Username: profile.Username, DisplayName: profile.DisplayName, Email: profile.Email,
+	})
+	if err != nil {
+		if errors.Is(err, model.ErrDatabase) {
+			return nil, err
+		}
+		return nil, service.ErrAuthTokenInvalid
+	}
+	return model.GetUserCache(bound.Id)
+}
