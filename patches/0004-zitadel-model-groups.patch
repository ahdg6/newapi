index 663f3dd..e2c4ea7 100644
--- a/model/dsh_oidc_sync.go
+++ b/model/dsh_oidc_sync.go
@@ -49,3 +49,46 @@ func DisableDSHOIDCUser(userID int, subject string) (bool, error) {
 	tokenErr := InvalidateUserTokensCache(userID)
 	return true, errors.Join(cacheErr, sessionErr, tokenErr)
 }
+
+// SyncDSHOIDCUserGroup changes only group membership for the exact observed
+// binding. Local New API administrators always retain full model access. The
+// authentication-version fence prevents an old cached group from authorizing
+// relay keys or browser sessions after a demotion commits.
+func SyncDSHOIDCUserGroup(userID int, subject string, privileged bool) (bool, error) {
+	if userID <= 0 {
+		return false, errors.New("invalid OIDC account binding")
+	}
+	changed := false
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var current User
+		if err := lockForUpdate(tx).Where("id = ? AND oidc_id = ? AND status = ?", userID, subject, common.UserStatusEnabled).First(&current).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return nil
+			}
+			return err
+		}
+		group := "default"
+		if privileged || current.Role >= common.RoleAdminUser {
+			group = "external"
+		}
+		if current.Group == group {
+			return nil
+		}
+		if _, err := IncrementUserAuthVersionWithTx(tx, userID); err != nil {
+			return err
+		}
+		if err := tx.Model(&current).Update("group", group).Error; err != nil {
+			return err
+		}
+		changed = true
+		return nil
+	})
+	if err != nil || !changed {
+		return false, err
+	}
+	common.SysLog(common.LogText("DSH OIDC group sync updated New API user %d", userID))
+	cacheErr := PublishUserAuthCache(userID)
+	_, sessionErr := RevokeAllUserSessions(userID, "oidc_group_changed")
+	tokenErr := InvalidateUserTokensCache(userID)
+	return true, errors.Join(cacheErr, sessionErr, tokenErr)
+}
