+				setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+					if r.Method == http.MethodGet {
+						_, _ = w.Write([]byte(`{"user":{"userId":"last-page","state":"USER_STATE_ACTIVE","details":{"resourceOwner":"organization"}}}`))
+						return
+					}
+					if r.URL.Path == "/management/v1/orgs/me/members/_search" {
+						_, _ = w.Write([]byte(`{"details":{"totalResult":"0","processedSequence":"1"}}`))
+						return
+					}
+					var query struct {
+						Query struct {
+							Offset string `json:"offset"`
+						} `json:"query"`
+						Queries []struct {
+							ProjectIDQuery struct {
+								ProjectID string `json:"projectId"`
+							} `json:"projectIdQuery"`
+						} `json:"queries"`
+					}
+					assert.NoError(t, common.DecodeJsonBody(r.Body, &query))
+					assert.Equal(t, "project", query.Queries[0].ProjectIDQuery.ProjectID)
+					offset, err := strconv.Atoi(query.Query.Offset)
+					assert.NoError(t, err)
+					if offset == 100 && failPage {
+						w.WriteHeader(http.StatusForbidden)
+						return
+					}
+					entries := []map[string]any{}
+					for index := offset; index < min(offset+100, 101); index++ {
+						subject := fmt.Sprintf("role-%d", index)
+						if index == 100 {
+							subject = "last-page"
+						}
+						entries = append(entries, map[string]any{"id": subject, "userId": subject, "projectId": "project", "orgId": "organization",
+							"state": "USER_GRANT_STATE_ACTIVE", "roleKeys": []string{"manager"}, "details": map[string]string{"resourceOwner": "organization"}})
+					}
+					encoded, err := common.Marshal(map[string]any{"details": map[string]string{"totalResult": "101", "processedSequence": "1"}, "result": entries})
+					assert.NoError(t, err)
+					_, _ = w.Write(encoded)
+				}, http.MethodPost)
+				require.NoError(t, service.SyncDSHOIDCAccounts(context.Background()))
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, "external", user.Group)
+				failPage = true
+				err := service.SyncDSHOIDCAccounts(context.Background())
+				require.Error(t, err)
+				assert.NotContains(t, err.Error(), "isolated-test-service-token")
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, "external", user.Group, "a failed second page must not revoke existing grants")
+			})
+
+			t.Run("invalid role snapshots preserve privileges and binding changes win", func(t *testing.T) {
+				user := createDSHOIDCSyncUser(t, "invalid-roles", common.UserStatusEnabled)
+				require.NoError(t, model.DB.Model(user).Update("group", "external").Error)
+				for _, body := range []string{
+					`{`,
+					`{"result":[]}`,
+					`{"details":{"totalResult":"1"},"result":[]}`,
+					`{"details":{"totalResult":"1"},"result":[{"id":"grant","userId":"invalid-roles","projectId":"project","orgId":"organization","state":"FUTURE_STATE","roleKeys":["manager"],"details":{"resourceOwner":"organization"}}]}`,
+					`{"details":{"totalResult":"2"},"result":[{"id":"grant","userId":"invalid-roles","details":{"resourceOwner":"organization"}},{"id":"grant","userId":"invalid-roles","details":{"resourceOwner":"organization"}}]}`,
+				} {
+					t.Run(body, func(t *testing.T) {
+						setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+							if r.Method == http.MethodGet {
+								_, _ = w.Write([]byte(`{"user":{"userId":"invalid-roles","state":"USER_STATE_ACTIVE","details":{"resourceOwner":"organization"}}}`))
+								return
+							}
+							_, _ = w.Write([]byte(body))
+						}, http.MethodPost)
+						require.Error(t, service.SyncDSHOIDCAccounts(context.Background()))
+						require.NoError(t, model.DB.First(user, user.Id).Error)
+						assert.Equal(t, "external", user.Group)
+					})
+				}
+				require.NoError(t, model.DB.Model(user).Updates(map[string]any{"oidc_id": "new-binding", "display_name": "new profile"}).Error)
+				changed, err := model.SyncDSHOIDCUserGroup(user.Id, "invalid-roles", false)
+				require.NoError(t, err)
+				assert.False(t, changed)
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, "external", user.Group)
+				assert.Equal(t, "new profile", user.DisplayName)
+				assert.Equal(t, "new-binding", user.OidcId)
+				t.Setenv("DSH_OIDC_GROUP_SYNC_ORG_ID", "")
+				t.Setenv("DSH_OIDC_GROUP_SYNC_PROJECT_ID", "")
+				assert.NotContains(t, service.GetUserUsableGroups("external"), "chatgpt", "disabled group sync preserves upstream group rules")
+			})
+		})
+	}
+}
