+// dshOIDCPrivilegedSubjects reads complete, organization-scoped role snapshots
+// before applying any upstream-derived group changes. Grants from another
+// project or organization never authorize access in this deployment.
+func dshOIDCPrivilegedSubjects(ctx context.Context, client *http.Client, settings *dshOIDCAccountSyncConfig) (map[string]bool, error) {
+	privileged := make(map[string]bool)
+	for _, endpoint := range []string{"/management/v1/users/grants/_search", "/management/v1/orgs/me/members/_search"} {
+		isGrant := strings.Contains(endpoint, "/grants/")
+		offset, expectedTotal, sequence := 0, -1, ""
+		seen := make(map[string]bool)
+		for {
+			payload := map[string]any{"query": map[string]any{"offset": strconv.Itoa(offset), "limit": uint64(100), "asc": true}}
+			if isGrant {
+				payload["queries"] = []map[string]any{{"projectIdQuery": map[string]string{"projectId": settings.project}}}
+			}
+			encoded, err := common.Marshal(payload)
+			if err != nil {
+				return nil, errors.New("DSH OIDC group sync could not encode a role query")
+			}
+			request, err := http.NewRequestWithContext(ctx, http.MethodPost, settings.issuer+endpoint, bytes.NewReader(encoded))
+			if err != nil {
+				return nil, errors.New("DSH OIDC group sync could not construct a role query")
+			}
+			request.Header.Set("Authorization", "Bearer "+settings.token)
+			request.Header.Set("x-zitadel-orgid", settings.organization)
+			request.Header.Set("Content-Type", "application/json")
+			request.Header.Set("Accept", "application/json")
+			response, err := client.Do(request)
+			if err != nil {
+				return nil, errors.New("DSH OIDC group sync role lookup unavailable")
+			}
+			var page struct {
+				Details struct {
+					TotalResult       string `json:"totalResult"`
+					ProcessedSequence string `json:"processedSequence"`
+				} `json:"details"`
+				Result []struct {
+					ID        string   `json:"id"`
+					UserID    string   `json:"userId"`
+					ProjectID string   `json:"projectId"`
+					OrgID     string   `json:"orgId"`
+					State     string   `json:"state"`
+					RoleKeys  []string `json:"roleKeys"`
+					Roles     []string `json:"roles"`
+					Details   struct {
+						ResourceOwner string `json:"resourceOwner"`
+					} `json:"details"`
+				} `json:"result"`
+			}
+			body := &io.LimitedReader{R: response.Body, N: (1 << 20) + 1}
+			decodeErr := common.DecodeJsonBody(body, &page)
+			_ = response.Body.Close()
+			if response.StatusCode != http.StatusOK {
+				return nil, fmt.Errorf("DSH OIDC group sync role lookup returned HTTP %d", response.StatusCode)
+			}
+			total, totalErr := strconv.Atoi(page.Details.TotalResult)
+			if decodeErr != nil || body.N == 0 || totalErr != nil || total < 0 || total < offset || len(page.Result) > total-offset {
+				return nil, errors.New("DSH OIDC group sync received an invalid role page")
+			}
+			if offset > 0 && (total != expectedTotal || page.Details.ProcessedSequence != sequence) {
+				return nil, errors.New("DSH OIDC group sync role snapshot changed during pagination")
+			}
+			expectedTotal, sequence = total, page.Details.ProcessedSequence
+			for _, entry := range page.Result {
+				identity := entry.UserID
+				if isGrant {
+					identity = entry.ID
+				}
+				if identity == "" || entry.UserID == "" || entry.Details.ResourceOwner == "" || seen[identity] {
+					return nil, errors.New("DSH OIDC group sync received an invalid or repeated role assignment")
+				}
+				seen[identity] = true
+				if entry.Details.ResourceOwner != settings.organization {
+					continue
+				}
+				if isGrant {
+					if entry.ProjectID != settings.project || entry.OrgID != settings.organization {
+						continue
+					}
+					switch entry.State {
+					case "USER_GRANT_STATE_ACTIVE":
+						if slices.Contains(entry.RoleKeys, "manager") || slices.Contains(entry.RoleKeys, "admin") {
+							privileged[entry.UserID] = true
+						}
+					case "USER_GRANT_STATE_INACTIVE", "USER_GRANT_STATE_REMOVED":
+					default:
+						return nil, errors.New("DSH OIDC group sync received an unknown role assignment state")
+					}
+				} else if slices.Contains(entry.Roles, "ORG_OWNER") {
+					privileged[entry.UserID] = true
+				}
+			}
+			offset += len(page.Result)
+			if offset == total {
+				break
+			}
+			if len(page.Result) == 0 {
+				return nil, errors.New("DSH OIDC group sync received an incomplete role snapshot")
+			}
+		}
+	}
+	return privileged, nil
+}
