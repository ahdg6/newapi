+// Include disabled and unlinked users so removing a role can also cancel a
+// subscription when the account has already been deprovisioned locally.
+func revokeDSHOIDCSubscriptions(ctx context.Context, planID int, subjectRoles map[string]dshOIDCSubjectRoles) error {
+	db := model.DB.WithContext(ctx)
+	active := db.Model(&model.UserSubscription{}).Select("id").Where("status = ? AND end_time > ?", "active", model.GetDBTimestamp())
+	lastSubscriptionID := 0
+	var firstErr error
+	for {
+		var grants []model.DSHOIDCSubscriptionGrant
+		if err := db.Where("plan_id = ? AND subscription_id > ? AND subscription_id IN (?)", planID, lastSubscriptionID, active).
+			Order("subscription_id").Limit(100).Find(&grants).Error; err != nil {
+			return err
+		}
+		if len(grants) == 0 {
+			return firstErr
+		}
+		userIDs := make([]int, 0, len(grants))
+		for _, grant := range grants {
+			userIDs = append(userIDs, grant.UserID)
+		}
+		var users []model.User
+		if err := db.Unscoped().Select("id", "oidc_id", "deleted_at").Where("id IN ?", userIDs).Find(&users).Error; err != nil {
+			return err
+		}
+		byID := make(map[int]model.User, len(users))
+		for _, user := range users {
+			byID[user.Id] = user
+		}
+		for _, grant := range grants {
+			lastSubscriptionID = grant.SubscriptionID
+			user := byID[grant.UserID]
+			if !user.DeletedAt.Valid && user.OidcId == grant.Subject && subjectRoles[grant.Subject].subscription {
+				continue
+			}
+			action, err := model.RevokeDSHOIDCSubscription(ctx, grant, user.OidcId)
+			if err != nil && firstErr == nil {
+				firstErr = fmt.Errorf("DSH OIDC subscription revocation failed for New API user %d: %w", grant.UserID, err)
+			}
+			if action != "" {
+				common.SysLog(common.LogText("DSH OIDC subscription %s for New API user %d", action, grant.UserID))
+			}
+		}
+	}
 }
