@@ -0,0 +1,173 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/setting/operation_setting"
+	"gorm.io/gorm"
+)
+
+// DSHOIDCSubscriptionGrant records the one-time entitlement after the
+// subscription expires, is cancelled, or is deleted. It tracks adopted
+// subscriptions without changing their original amounts or dates.
+type DSHOIDCSubscriptionGrant struct {
+	Subject        string `gorm:"type:varchar(128);primaryKey"`
+	PlanID         int    `gorm:"primaryKey;autoIncrement:false;index:idx_dsh_oidc_subscription_plan_user,priority:1"`
+	UserID         int    `gorm:"not null;index:idx_dsh_oidc_subscription_plan_user,priority:2"`
+	SubscriptionID int    `gorm:"not null;uniqueIndex"`
+}
+
+func (DSHOIDCSubscriptionGrant) TableName() string {
+	return "dsh_oidc_subscription_grants"
+}
+
+// GrantDSHOIDCSubscription applies verified Zitadel eligibility to the exact
+// local account binding the caller observed. An existing grant is permanent
+// evidence of issuance, even after its subscription has gone.
+func GrantDSHOIDCSubscription(ctx context.Context, userID int, observedSubject string, planID int) (string, error) {
+	if userID <= 0 || planID <= 0 || observedSubject == "" || len(observedSubject) > 128 {
+		return "", errors.New("invalid OIDC subscription grant")
+	}
+
+	action := ""
+	err := DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var user User
+		err := lockForUpdate(tx).Select("id", "oidc_id", "role", "status").
+			Where("id = ?", userID).First(&user).Error
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if user.OidcId != observedSubject || user.Role != common.RoleCommonUser || user.Status != common.UserStatusEnabled {
+			return nil
+		}
+
+		var existing DSHOIDCSubscriptionGrant
+		err = tx.Where("plan_id = ? AND subject = ?", planID, observedSubject).First(&existing).Error
+		if !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+
+		// A historical duplicate binding cannot inherit an employee entitlement.
+		var bindings []User
+		if err := tx.Unscoped().Model(&User{}).Select("id").
+			Where("oidc_id = ?", observedSubject).Limit(2).Find(&bindings).Error; err != nil {
+			return err
+		}
+		if len(bindings) != 1 || bindings[0].Id != userID {
+			return ErrOIDCSubjectUnavailable
+		}
+		common.OptionMapRWMutex.RLock()
+		complianceConfirmed := operation_setting.IsPaymentComplianceConfirmed()
+		common.OptionMapRWMutex.RUnlock()
+		if !complianceConfirmed {
+			return errors.New("payment compliance is not confirmed for OIDC subscription issuance")
+		}
+
+		var plan SubscriptionPlan
+		if err := tx.Where("id = ?", planID).First(&plan).Error; err != nil {
+			return err
+		}
+		if !plan.Enabled || plan.TotalAmount <= 0 || strings.TrimSpace(plan.UpgradeGroup) != "" || strings.TrimSpace(plan.DowngradeGroup) != "" {
+			return errors.New("OIDC subscription plan must be enabled with finite quota and preserve the user's group")
+		}
+
+		now := common.GetTimestamp()
+		trackedSubscriptions := tx.Model(&DSHOIDCSubscriptionGrant{}).Select("subscription_id")
+		adminSubscriptions := lockForUpdate(tx).Model(&UserSubscription{}).
+			Where("user_id = ? AND plan_id = ? AND source = ?", userID, planID, "admin").
+			Where("id NOT IN (?)", trackedSubscriptions).
+			Session(&gorm.Session{})
+
+		var activeAdmin []UserSubscription
+		if err := adminSubscriptions.Select("id", "upgrade_group", "downgrade_group").
+			Where("status = ? AND end_time > ?", "active", now).Limit(2).Find(&activeAdmin).Error; err != nil {
+			return err
+		}
+		grant := DSHOIDCSubscriptionGrant{Subject: observedSubject, PlanID: planID, UserID: userID}
+		if len(activeAdmin) > 1 {
+			return errors.New("multiple active admin subscriptions match the OIDC entitlement")
+		}
+		if len(activeAdmin) == 1 {
+			subscription := activeAdmin[0]
+			if strings.TrimSpace(subscription.UpgradeGroup) != "" || strings.TrimSpace(subscription.DowngradeGroup) != "" {
+				return errors.New("OIDC entitlement cannot adopt a subscription that changes the user's group")
+			}
+			grant.SubscriptionID = subscription.Id
+		} else {
+			var earlier UserSubscription
+			err := adminSubscriptions.Select("id").Where("status IN ? OR (status = ? AND end_time <= ?)", []string{"cancelled", "expired"}, "active", now).
+				Order("id DESC").First(&earlier).Error
+			if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+				return err
+			}
+			grant.SubscriptionID = earlier.Id
+		}
+		if grant.SubscriptionID != 0 {
+			action = "adopted"
+		} else {
+			// Existing paid or otherwise managed subscriptions take priority
+			// while active and are never adopted by this entitlement.
+			var active UserSubscription
+			err := lockForUpdate(tx).Select("id").
+				Where("user_id = ? AND plan_id = ? AND status = ? AND end_time > ?", userID, planID, "active", now).
+				First(&active).Error
+			if !errors.Is(err, gorm.ErrRecordNotFound) {
+				return err
+			}
+			subscription, err := CreateUserSubscriptionFromPlanTx(tx, userID, &plan, "admin")
+			if err != nil {
+				return err
+			}
+			grant.SubscriptionID = subscription.Id
+			action = "issued"
+		}
+		return tx.Create(&grant).Error
+	})
+	if err != nil {
+		return "", err
+	}
+	return action, nil
+}
+
+// RevokeDSHOIDCSubscription cancels the exact active subscription owned by
+// this grant and leaves the durable once-only record in place.
+func RevokeDSHOIDCSubscription(ctx context.Context, grant DSHOIDCSubscriptionGrant, observedSubject string) (string, error) {
+	if grant.UserID <= 0 || grant.PlanID <= 0 || grant.SubscriptionID <= 0 || grant.Subject == "" || len(grant.Subject) > 128 {
+		return "", errors.New("invalid OIDC subscription revocation")
+	}
+
+	action := ""
+	err := DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var user User
+		err := lockForUpdate(tx).Unscoped().Select("id", "oidc_id").
+			Where("id = ?", grant.UserID).First(&user).Error
+		if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		if user.Id != 0 && user.OidcId != observedSubject {
+			return nil
+		}
+		owner := tx.Model(&DSHOIDCSubscriptionGrant{}).Select("1").
+			Where("subject = ? AND plan_id = ? AND user_id = ? AND subscription_id = ?", grant.Subject, grant.PlanID, grant.UserID, grant.SubscriptionID)
+		now := common.GetTimestamp()
+		result := tx.Model(&UserSubscription{}).
+			Where("id = ? AND plan_id = ? AND user_id = ? AND source = ?", grant.SubscriptionID, grant.PlanID, grant.UserID, "admin").
+			Where("status = ? AND end_time > ?", "active", now).
+			Where("EXISTS (?)", owner).
+			Updates(map[string]any{"status": "cancelled", "end_time": now, "updated_at": now})
+		if result.RowsAffected > 0 {
+			action = "revoked"
+		}
+		return result.Error
+	})
+	if err != nil {
+		return "", err
+	}
+	return action, nil
+}
