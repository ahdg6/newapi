diff --git a/model/dsh_oidc_sync.go b/model/dsh_oidc_sync.go
new file mode 100644
index 0000000..663f3dd
--- /dev/null
+++ b/model/dsh_oidc_sync.go
@@ -0,0 +1,51 @@
+package model
+
+import (
+	"errors"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+// DisableDSHOIDCUser applies an authoritative upstream account restriction only
+// while the exact binding observed by the synchronizer is still enabled. It
+// never writes an old profile snapshot or enables an account.
+func DisableDSHOIDCUser(userID int, subject string) (bool, error) {
+	if userID <= 0 || subject == "" {
+		return false, errors.New("invalid OIDC account binding")
+	}
+	changed := false
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var current User
+		if err := lockForUpdate(tx).Where("id = ? AND oidc_id = ? AND status = ?", userID, subject, common.UserStatusEnabled).First(&current).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return nil
+			}
+			return err
+		}
+		if _, err := IncrementUserAuthVersionWithTx(tx, userID); err != nil {
+			return err
+		}
+		result := tx.Model(&User{}).
+			Where("id = ? AND oidc_id = ? AND status = ?", userID, subject, common.UserStatusEnabled).
+			Update("status", common.UserStatusDisabled)
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return ErrUserAuthVersionConflict
+		}
+		changed = true
+		return nil
+	})
+	if err != nil || !changed {
+		return false, err
+	}
+	// Try every finalizer even if one fails. The committed status/version and
+	// upstream cache fence already reject old credentials; do not clear the
+	// freshly published user hash or its authentication version floor.
+	cacheErr := PublishUserAuthCache(userID)
+	_, sessionErr := RevokeAllUserSessions(userID, "oidc_account_disabled")
+	tokenErr := InvalidateUserTokensCache(userID)
+	return true, errors.Join(cacheErr, sessionErr, tokenErr)
+}
diff --git a/service/dsh_oidc_sync.go b/service/dsh_oidc_sync.go
new file mode 100644
index 0000000..26e2036
--- /dev/null
+++ b/service/dsh_oidc_sync.go
@@ -0,0 +1,172 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+)
+
+type dshOIDCAccountSyncConfig struct {
+	issuer   string
+	token    string
+	interval time.Duration
+}
+
+func dshOIDCAccountSyncSettings() (*dshOIDCAccountSyncConfig, error) {
+	token := os.Getenv("DSH_OIDC_SYNC_TOKEN")
+	if token == "" {
+		return nil, nil
+	}
+	if strings.TrimSpace(token) != token || strings.ContainsAny(token, "\r\n") {
+		return nil, errors.New("DSH_OIDC_SYNC_TOKEN must be an unpadded bearer token")
+	}
+	issuer := strings.TrimRight(os.Getenv("DSH_OIDC_ISSUER"), "/")
+	issuerURL, err := url.Parse(issuer)
+	if err != nil || issuerURL.Scheme != "https" || issuerURL.Host == "" || issuerURL.User != nil || issuerURL.RawQuery != "" || issuerURL.Fragment != "" {
+		return nil, errors.New("DSH OIDC account sync requires a valid HTTPS DSH_OIDC_ISSUER")
+	}
+	settings := system_setting.GetOIDCSettings()
+	if settings.WellKnown != issuer+"/.well-known/openid-configuration" {
+		return nil, errors.New("DSH OIDC account sync requires browser OIDC discovery to match DSH_OIDC_ISSUER")
+	}
+	for _, endpoint := range []string{settings.AuthorizationEndpoint, settings.TokenEndpoint, settings.UserInfoEndpoint} {
+		if endpoint == "" {
+			continue
+		}
+		endpointURL, parseErr := url.Parse(endpoint)
+		if parseErr != nil || endpointURL.Scheme != issuerURL.Scheme || endpointURL.Host != issuerURL.Host || endpointURL.User != nil || endpointURL.Fragment != "" || !strings.HasPrefix(endpointURL.Path, strings.TrimRight(issuerURL.Path, "/")+"/") {
+			return nil, errors.New("DSH OIDC account sync requires browser OIDC endpoints from the configured issuer")
+		}
+	}
+	interval := time.Minute
+	if raw := os.Getenv("DSH_OIDC_SYNC_INTERVAL"); raw != "" {
+		interval, err = time.ParseDuration(raw)
+		if err != nil || interval < 10*time.Second || interval > 24*time.Hour {
+			return nil, errors.New("DSH_OIDC_SYNC_INTERVAL must be a duration between 10s and 24h")
+		}
+	}
+	return &dshOIDCAccountSyncConfig{issuer: issuer, token: token, interval: interval}, nil
+}
+
+// StartDSHOIDCAccountSync scans immediately and periodically on master nodes.
+// The service-account credential is opt-in; normal OIDC deployments are inert.
+func StartDSHOIDCAccountSync() error {
+	settings, err := dshOIDCAccountSyncSettings()
+	if err != nil {
+		return err
+	}
+	if settings == nil || !common.IsMasterNode {
+		return nil
+	}
+	go func() {
+		ticker := time.NewTicker(settings.interval)
+		defer ticker.Stop()
+		for {
+			if err := SyncDSHOIDCAccounts(context.Background()); err != nil {
+				common.SysError(common.LogText("DSH OIDC account sync failed: %s", err.Error()))
+			}
+			<-ticker.C
+		}
+	}()
+	return nil
+}
+
+// SyncDSHOIDCAccounts checks every enabled OIDC-linked account, including idle
+// accounts whose only activity is through relay API keys. Revoked/expired user
+// tokens and logout events are not authoritative account-disable signals.
+func SyncDSHOIDCAccounts(ctx context.Context) error {
+	// Recheck settings on every pass: browser OIDC configuration can be changed
+	// without restarting, and users.oidc_id is scoped to one configured issuer.
+	settings, err := dshOIDCAccountSyncSettings()
+	if err != nil || settings == nil {
+		return err
+	}
+	client := &http.Client{
+		Timeout: 5 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	var firstErr error
+	lastID := 0
+	for {
+		var users []model.User
+		if err := model.DB.WithContext(ctx).Select("id", "oidc_id").
+			Where("id > ? AND oidc_id <> ? AND status = ?", lastID, "", common.UserStatusEnabled).
+			Order("id").Limit(100).Find(&users).Error; err != nil {
+			return err
+		}
+		if len(users) == 0 {
+			return firstErr
+		}
+		for _, user := range users {
+			lastID = user.Id
+			request, err := http.NewRequestWithContext(ctx, http.MethodGet, settings.issuer+"/v2/users/"+url.PathEscape(user.OidcId), nil)
+			if err != nil {
+				return errors.New("DSH OIDC account sync could not construct the user lookup")
+			}
+			request.Header.Set("Authorization", "Bearer "+settings.token)
+			request.Header.Set("Accept", "application/json")
+			response, err := client.Do(request)
+			if err != nil {
+				// Never log a response body, transport error, or request containing
+				// credentials. Stop this pass when the identity service is down.
+				return errors.New("DSH OIDC account sync user lookup unavailable")
+			}
+			var payload struct {
+				User struct {
+					ID    string `json:"userId"`
+					State string `json:"state"`
+				} `json:"user"`
+			}
+			body := &io.LimitedReader{R: response.Body, N: (1 << 20) + 1}
+			decodeErr := common.DecodeJsonBody(body, &payload)
+			if body.N == 0 {
+				decodeErr = errors.New("OIDC user response exceeds the size limit")
+			}
+			_ = response.Body.Close()
+			if response.StatusCode != http.StatusOK {
+				lookupErr := fmt.Errorf("DSH OIDC account sync user lookup returned HTTP %d", response.StatusCode)
+				if response.StatusCode != http.StatusNotFound {
+					return lookupErr
+				}
+				if firstErr == nil {
+					firstErr = lookupErr
+				}
+				continue
+			}
+			if decodeErr != nil || payload.User.ID != user.OidcId {
+				if firstErr == nil {
+					firstErr = errors.New("DSH OIDC account sync received an invalid user response")
+				}
+				continue
+			}
+			switch payload.User.State {
+			case "USER_STATE_ACTIVE", "USER_STATE_INITIAL":
+				continue
+			case "USER_STATE_INACTIVE", "USER_STATE_LOCKED", "USER_STATE_DELETED":
+				changed, disableErr := model.DisableDSHOIDCUser(user.Id, user.OidcId)
+				if changed {
+					common.SysLog(common.LogText("DSH OIDC account sync disabled New API user %d (%s)", user.Id, payload.User.State))
+				}
+				if disableErr != nil {
+					return disableErr
+				}
+			default:
+				if firstErr == nil {
+					firstErr = errors.New("DSH OIDC account sync received an unknown user state")
+				}
+			}
+		}
+	}
+}
