@@ -0,0 +1,379 @@
+package service_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/middleware"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/gin-gonic/gin"
+	"github.com/go-redis/redis/v8"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func setupDSHOIDCSyncDatabase(t *testing.T, dialect string) {
+	t.Helper()
+	dsn := ""
+	if dialect == "mysql" {
+		dsn = os.Getenv("TEST_MYSQL_DSN")
+		if dsn == "" {
+			t.Skip("TEST_MYSQL_DSN is not configured")
+		}
+	}
+	if dialect == "postgres" {
+		dsn = os.Getenv("TEST_POSTGRES_DSN")
+		if dsn == "" {
+			t.Skip("TEST_POSTGRES_DSN is not configured")
+		}
+		require.True(t, strings.HasPrefix(dsn, "postgres://") || strings.HasPrefix(dsn, "postgresql://"), "TEST_POSTGRES_DSN must be a PostgreSQL URL")
+	}
+	previousDB, previousLogDB := model.DB, model.LOG_DB
+	previousMainType, previousLogType := common.MainDatabaseType(), common.LogDatabaseType()
+	previousSQLite, previousMaster := common.SQLitePath, common.IsMasterNode
+	previousRedis, previousRDB := common.RedisEnabled, common.RDB
+	previousSecret, previousFrequency := common.SessionSecret, common.SyncFrequency
+	t.Cleanup(func() {
+		model.DB, model.LOG_DB = previousDB, previousLogDB
+		common.SetDatabaseTypes(previousMainType, previousLogType)
+		common.SQLitePath, common.IsMasterNode = previousSQLite, previousMaster
+		common.RedisEnabled, common.RDB = previousRedis, previousRDB
+		common.SessionSecret, common.SyncFrequency = previousSecret, previousFrequency
+	})
+	t.Setenv("SQL_DSN", dsn)
+	t.Setenv("LOG_SQL_DSN", "")
+	common.SQLitePath = filepath.Join(t.TempDir(), "oidc-sync.db") + "?_pragma=busy_timeout(30000)&_pragma=journal_mode(WAL)&_txlock=immediate"
+	common.IsMasterNode, common.RedisEnabled = false, false
+	common.SessionSecret = "oidc-sync-test-session-secret-with-sufficient-entropy"
+	common.SyncFrequency = 60
+	// Use startup's dialect initialization as well as its DB connection. Relay
+	// token lookup and invalidation use the initialized reserved-column names.
+	require.NoError(t, model.InitDB())
+	db := model.DB
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, sqlDB.Close()) })
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.UserSession{}, &model.UserAccessToken{}, &model.AuthFlow{}, &model.Token{}, &model.Option{}, &model.AuditLog{}))
+	model.LOG_DB = db
+	require.NoError(t, model.EnsureLegacyAccessTokenRetireAt(time.Now().Unix()))
+	var version string
+	query := "SELECT version()"
+	if dialect == "sqlite" {
+		query = "SELECT sqlite_version()"
+	}
+	require.NoError(t, db.Raw(query).Scan(&version).Error)
+	t.Logf("database version: %s", version)
+	cache := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: cache.Addr()})
+	t.Cleanup(func() { require.NoError(t, client.Close()) })
+	common.RedisEnabled, common.RDB = true, client
+}
+
+func createDSHOIDCSyncUser(t *testing.T, subject string, status int) *model.User {
+	t.Helper()
+	user := &model.User{
+		Username: "sync-" + common.GetRandomString(12), Password: "unused-hash",
+		OidcId: subject, Status: status, Role: common.RoleCommonUser,
+		Group: "default", Quota: 1000, AuthVersion: 1, AffCode: common.GetRandomString(16),
+	}
+	require.NoError(t, model.DB.Create(user).Error)
+	t.Cleanup(func() {
+		require.NoError(t, model.DB.Where("user_id = ?", user.Id).Delete(&model.UserSession{}).Error)
+		require.NoError(t, model.DB.Where("user_id = ?", user.Id).Delete(&model.UserAccessToken{}).Error)
+		require.NoError(t, model.DB.Unscoped().Where("user_id = ?", user.Id).Delete(&model.Token{}).Error)
+		require.NoError(t, model.DB.Unscoped().Delete(user).Error)
+	})
+	return user
+}
+
+func setupDSHOIDCSyncIssuer(t *testing.T, handler http.HandlerFunc) *httptest.Server {
+	t.Helper()
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		assert.Equal(t, "Bearer isolated-test-service-token", r.Header.Get("Authorization"))
+		assert.Equal(t, http.MethodGet, r.Method)
+		handler(w, r)
+	}))
+	t.Cleanup(server.Close)
+	previousTransport := http.DefaultTransport
+	http.DefaultTransport = server.Client().Transport
+	previousSettings := *system_setting.GetOIDCSettings()
+	*system_setting.GetOIDCSettings() = system_setting.OIDCSettings{
+		Enabled: true, WellKnown: server.URL + "/.well-known/openid-configuration",
+		UserInfoEndpoint: server.URL + "/oidc/v1/userinfo",
+	}
+	t.Cleanup(func() {
+		http.DefaultTransport = previousTransport
+		*system_setting.GetOIDCSettings() = previousSettings
+	})
+	t.Setenv("DSH_OIDC_ISSUER", server.URL)
+	t.Setenv("DSH_OIDC_SYNC_TOKEN", "isolated-test-service-token")
+	t.Setenv("DSH_OIDC_SYNC_INTERVAL", "60s")
+	return server
+}
+
+func TestDSHOIDCAccountSync(t *testing.T) {
+	for _, dialect := range []string{"sqlite", "mysql", "postgres"} {
+		t.Run(dialect, func(t *testing.T) {
+			setupDSHOIDCSyncDatabase(t, dialect)
+			t.Run("authoritative states preserve local restrictions", func(t *testing.T) {
+				states := map[string]string{}
+				setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+					subject := strings.TrimPrefix(r.URL.Path, "/v2/users/")
+					_, _ = fmt.Fprintf(w, `{"user":{"userId":%q,"state":%q}}`, subject, states[subject])
+				})
+				cases := []struct {
+					state    string
+					disabled bool
+				}{
+					{"USER_STATE_ACTIVE", false}, {"USER_STATE_INITIAL", false},
+					{"USER_STATE_INACTIVE", true}, {"USER_STATE_LOCKED", true}, {"USER_STATE_DELETED", true},
+					{"USER_STATE_UNSPECIFIED", false}, {"USER_STATE_FUTURE", false},
+				}
+				users := make([]*model.User, 0, len(cases))
+				for _, tc := range cases {
+					subject := "state-" + tc.state
+					states[subject] = tc.state
+					users = append(users, createDSHOIDCSyncUser(t, subject, common.UserStatusEnabled))
+				}
+				local := createDSHOIDCSyncUser(t, "local-disabled", common.UserStatusDisabled)
+				unbound := createDSHOIDCSyncUser(t, "", common.UserStatusEnabled)
+				require.Error(t, service.SyncDSHOIDCAccounts(context.Background()), "unknown upstream states are reported without changing those accounts")
+				for i, user := range users {
+					require.NoError(t, model.DB.First(user, user.Id).Error)
+					wantStatus, wantVersion := common.UserStatusEnabled, int64(1)
+					if cases[i].disabled {
+						wantStatus, wantVersion = common.UserStatusDisabled, 2
+					}
+					assert.Equal(t, wantStatus, user.Status, cases[i].state)
+					assert.Equal(t, wantVersion, user.AuthVersion, cases[i].state)
+				}
+				require.NoError(t, model.DB.First(local, local.Id).Error)
+				assert.Equal(t, common.UserStatusDisabled, local.Status)
+				assert.EqualValues(t, 1, local.AuthVersion)
+				require.NoError(t, model.DB.First(unbound, unbound.Id).Error)
+				assert.Equal(t, common.UserStatusEnabled, unbound.Status)
+			})
+
+			t.Run("session and cached dashboard and relay keys are denied", func(t *testing.T) {
+				user := createDSHOIDCSyncUser(t, "credential-owner", common.UserStatusEnabled)
+				var disabled atomic.Bool
+				setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+					state := "USER_STATE_ACTIVE"
+					if disabled.Load() {
+						state = "USER_STATE_INACTIVE"
+					}
+					_, _ = fmt.Fprintf(w, `{"user":{"userId":"credential-owner","state":%q}}`, state)
+				})
+				bundle, err := service.CreateLoginSession(user.Id, "oidc", "127.0.0.1", "sync-test")
+				require.NoError(t, err)
+				patRaw := model.AccessTokenPrefix + common.GetRandomString(44)
+				pat := &model.UserAccessToken{TokenHash: model.AccessTokenFingerprint(patRaw), Name: "sync-test"}
+				require.NoError(t, pat.SetScopes([]string{"profile:read"}))
+				require.NoError(t, model.CreateUserAccessToken(user.Id, pat, 10))
+				relay := &model.Token{UserId: user.Id, Key: common.GetRandomString(48), Status: common.TokenStatusEnabled, UnlimitedQuota: true, ExpiredTime: -1}
+				require.NoError(t, model.DB.Create(relay).Error)
+				router := gin.New()
+				router.GET("/api/models", middleware.UserAuth(), func(c *gin.Context) { c.Status(http.StatusOK) })
+				router.GET("/v1/models", middleware.TokenAuth(), func(c *gin.Context) { c.Status(http.StatusOK) })
+				router.GET("/api/usage/token", middleware.TokenAuthReadOnly(), func(c *gin.Context) { c.Status(http.StatusOK) })
+				credentials := []struct{ route, token string }{
+					{"/api/models", bundle.AccessToken}, {"/api/models", patRaw},
+					{"/v1/models", "sk-" + relay.Key}, {"/api/usage/token", "sk-" + relay.Key},
+				}
+				for _, credential := range credentials {
+					request := httptest.NewRequest(http.MethodGet, credential.route, nil)
+					request.Header.Set("Authorization", "Bearer "+credential.token)
+					response := httptest.NewRecorder()
+					router.ServeHTTP(response, request)
+					require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+				}
+				disabled.Store(true)
+				require.NoError(t, service.SyncDSHOIDCAccounts(context.Background()))
+				for _, credential := range credentials {
+					request := httptest.NewRequest(http.MethodGet, credential.route, nil)
+					request.Header.Set("Authorization", "Bearer "+credential.token)
+					response := httptest.NewRecorder()
+					router.ServeHTTP(response, request)
+					assert.Contains(t, []int{http.StatusUnauthorized, http.StatusForbidden}, response.Code, response.Body.String())
+				}
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, common.UserStatusDisabled, user.Status)
+				assert.EqualValues(t, 2, user.AuthVersion)
+				var session model.UserSession
+				require.NoError(t, model.DB.Where("sid = ?", bundle.Session.SID).First(&session).Error)
+				assert.Equal(t, model.UserSessionStatusRevoked, session.Status)
+				disabled.Store(false)
+				require.NoError(t, service.SyncDSHOIDCAccounts(context.Background()))
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, common.UserStatusDisabled, user.Status, "reactivating upstream must not enable New API")
+				assert.EqualValues(t, 2, user.AuthVersion, "repeated passes are idempotent")
+			})
+
+			t.Run("binding and profile changes during lookup are preserved", func(t *testing.T) {
+				for _, rebind := range []bool{false, true} {
+					t.Run(fmt.Sprintf("rebind=%t", rebind), func(t *testing.T) {
+						user := createDSHOIDCSyncUser(t, "old-binding", common.UserStatusEnabled)
+						subject := "old-binding"
+						if rebind {
+							subject = "new-binding"
+						}
+						setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+							assert.NoError(t, model.DB.Model(user).Updates(map[string]any{"oidc_id": subject, "display_name": "edited profile", "role": common.RoleAdminUser}).Error)
+							_, _ = w.Write([]byte(`{"user":{"userId":"old-binding","state":"USER_STATE_LOCKED"}}`))
+						})
+						require.NoError(t, service.SyncDSHOIDCAccounts(context.Background()))
+						require.NoError(t, model.DB.First(user, user.Id).Error)
+						wantStatus, wantVersion := common.UserStatusDisabled, int64(2)
+						if rebind {
+							wantStatus, wantVersion = common.UserStatusEnabled, 1
+						}
+						assert.Equal(t, wantStatus, user.Status)
+						assert.Equal(t, wantVersion, user.AuthVersion)
+						assert.Equal(t, subject, user.OidcId)
+						assert.Equal(t, "edited profile", user.DisplayName)
+						assert.Equal(t, common.RoleAdminUser, user.Role)
+					})
+				}
+			})
+
+			t.Run("concurrent masters disable once", func(t *testing.T) {
+				user := createDSHOIDCSyncUser(t, "concurrent-master", common.UserStatusEnabled)
+				var workers sync.WaitGroup
+				var changed atomic.Int32
+				for range 2 {
+					workers.Go(func() {
+						didChange, err := model.DisableDSHOIDCUser(user.Id, user.OidcId)
+						assert.NoError(t, err)
+						if didChange {
+							changed.Add(1)
+						}
+					})
+				}
+				workers.Wait()
+				assert.EqualValues(t, 1, changed.Load())
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, common.UserStatusDisabled, user.Status)
+				assert.EqualValues(t, 2, user.AuthVersion)
+			})
+
+			t.Run("idle accounts beyond the first page are checked", func(t *testing.T) {
+				setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+					subject := strings.TrimPrefix(r.URL.Path, "/v2/users/")
+					state := "USER_STATE_ACTIVE"
+					if subject == "page-100" {
+						state = "USER_STATE_INACTIVE"
+					}
+					_, _ = fmt.Fprintf(w, `{"user":{"userId":%q,"state":%q}}`, subject, state)
+				})
+				var last *model.User
+				for i := range 101 {
+					last = createDSHOIDCSyncUser(t, fmt.Sprintf("page-%d", i), common.UserStatusEnabled)
+				}
+				require.NoError(t, service.SyncDSHOIDCAccounts(context.Background()))
+				require.NoError(t, model.DB.First(last, last.Id).Error)
+				assert.Equal(t, common.UserStatusDisabled, last.Status)
+			})
+
+			t.Run("lookup failures never disable accounts", func(t *testing.T) {
+				for _, tc := range []struct {
+					name   string
+					status int
+					body   string
+				}{
+					{"unauthorized", 401, ""}, {"forbidden", 403, ""}, {"not found", 404, ""},
+					{"rate limited", 429, ""}, {"server failure", 500, ""},
+					{"invalid JSON", 200, "{"}, {"mismatched subject", 200, `{"user":{"userId":"wrong","state":"USER_STATE_INACTIVE"}}`},
+					{"trailing garbage", 200, `{"user":{"userId":"failed-lookup","state":"USER_STATE_INACTIVE"}} garbage`},
+					{"multiple JSON values", 200, `{"user":{"userId":"failed-lookup","state":"USER_STATE_INACTIVE"}} {}`},
+					{"numeric enum", 200, `{"user":{"userId":"failed-lookup","state":2}}`},
+				} {
+					t.Run(tc.name, func(t *testing.T) {
+						user := createDSHOIDCSyncUser(t, "failed-lookup", common.UserStatusEnabled)
+						setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+							w.WriteHeader(tc.status)
+							_, _ = w.Write([]byte(tc.body))
+						})
+						err := service.SyncDSHOIDCAccounts(context.Background())
+						require.Error(t, err)
+						assert.NotContains(t, err.Error(), "isolated-test-service-token")
+						require.NoError(t, model.DB.First(user, user.Id).Error)
+						assert.Equal(t, common.UserStatusEnabled, user.Status)
+						assert.EqualValues(t, 1, user.AuthVersion)
+					})
+				}
+			})
+
+			t.Run("transport failures and redirects preserve accounts and secrets", func(t *testing.T) {
+				user := createDSHOIDCSyncUser(t, "transport-lookup", common.UserStatusEnabled)
+				var redirected atomic.Int32
+				destination := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { redirected.Add(1) }))
+				t.Cleanup(destination.Close)
+				setupDSHOIDCSyncIssuer(t, func(w http.ResponseWriter, r *http.Request) {
+					http.Redirect(w, r, destination.URL, http.StatusTemporaryRedirect)
+				})
+				require.Error(t, service.SyncDSHOIDCAccounts(context.Background()))
+				assert.Zero(t, redirected.Load(), "service credentials must not follow a redirect")
+				http.DefaultTransport = dshOIDCSyncFailedTransport{}
+				err := service.SyncDSHOIDCAccounts(context.Background())
+				require.Error(t, err)
+				assert.NotContains(t, err.Error(), "isolated-test-service-token")
+				require.NoError(t, model.DB.First(user, user.Id).Error)
+				assert.Equal(t, common.UserStatusEnabled, user.Status)
+				assert.EqualValues(t, 1, user.AuthVersion)
+			})
+		})
+	}
+}
+
+type dshOIDCSyncFailedTransport struct{}
+
+func (dshOIDCSyncFailedTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errors.New("transport timeout: isolated-test-service-token")
+}
+
+func TestDSHOIDCAccountSyncConfiguration(t *testing.T) {
+	setupDSHOIDCSyncIssuer(t, func(http.ResponseWriter, *http.Request) { t.Error("invalid configuration must not call the issuer") })
+	t.Run("disabled by default", func(t *testing.T) {
+		t.Setenv("DSH_OIDC_SYNC_TOKEN", "")
+		require.NoError(t, service.SyncDSHOIDCAccounts(context.Background()))
+	})
+	for _, tc := range []struct{ key, value string }{
+		{"DSH_OIDC_ISSUER", ""}, {"DSH_OIDC_ISSUER", "http://issuer.test"},
+		{"DSH_OIDC_ISSUER", "https://user:password@issuer.test"},
+		{"DSH_OIDC_ISSUER", "https://issuer.test?unexpected=query"},
+		{"DSH_OIDC_SYNC_TOKEN", "padded-token\n"},
+		{"DSH_OIDC_SYNC_INTERVAL", "0s"}, {"DSH_OIDC_SYNC_INTERVAL", "9s"},
+		{"DSH_OIDC_SYNC_INTERVAL", "25h"}, {"DSH_OIDC_SYNC_INTERVAL", "invalid"},
+	} {
+		t.Run(tc.key+" "+tc.value, func(t *testing.T) {
+			t.Setenv(tc.key, tc.value)
+			require.Error(t, service.SyncDSHOIDCAccounts(context.Background()))
+		})
+	}
+	t.Run("browser issuer changes are rechecked", func(t *testing.T) {
+		previous := system_setting.GetOIDCSettings().WellKnown
+		system_setting.GetOIDCSettings().WellKnown = "https://other-issuer.test/.well-known/openid-configuration"
+		t.Cleanup(func() { system_setting.GetOIDCSettings().WellKnown = previous })
+		require.Error(t, service.SyncDSHOIDCAccounts(context.Background()))
+	})
+	t.Run("browser endpoints cannot send credentials to another issuer", func(t *testing.T) {
+		previous := system_setting.GetOIDCSettings().UserInfoEndpoint
+		system_setting.GetOIDCSettings().UserInfoEndpoint = "https://other-issuer.test/oidc/v1/userinfo"
+		t.Cleanup(func() { system_setting.GetOIDCSettings().UserInfoEndpoint = previous })
+		require.Error(t, service.SyncDSHOIDCAccounts(context.Background()))
+	})
+}
