@@ -0,0 +1,71 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import {
+  createMemoryHistory,
+  createRootRoute,
+  createRouter,
+  RouterProvider,
+} from '@tanstack/react-router'
+import { act, cleanup, render, screen } from '@testing-library/react'
+import { createInstance } from 'i18next'
+import { I18nextProvider } from 'react-i18next'
+import { afterEach, expect, it } from 'vitest'
+
+import en from '@/i18n/locales/en.json'
+import zh from '@/i18n/locales/zh.json'
+import { STATUS_QUERY_KEY } from '@/lib/status-query'
+import { useSystemConfigStore } from '@/stores/system-config-store'
+
+import { Footer } from '../footer'
+
+const initialConfig = useSystemConfigStore.getState().config
+
+afterEach(() => {
+  cleanup()
+  useSystemConfigStore.setState({ config: initialConfig })
+  localStorage.clear()
+})
+
+it.each(['', '<p>Custom footer</p>'])(
+  'keeps upstream attribution and modified source available with footer HTML %j',
+  async (footerHtml) => {
+    useSystemConfigStore.getState().setConfig({ footerHtml })
+    const client = new QueryClient()
+    client.setQueryData(STATUS_QUERY_KEY, {})
+    const i18n = createInstance()
+    await i18n.init({
+      lng: 'en',
+      resources: { en: { translation: en }, zh: { translation: zh } },
+    })
+    const router = createRouter({
+      routeTree: createRootRoute({ component: Footer }),
+      history: createMemoryHistory({ initialEntries: ['/'] }),
+    })
+    await router.load()
+    render(
+      <I18nextProvider i18n={i18n}>
+        <QueryClientProvider client={client}>
+          <RouterProvider router={router} />
+        </QueryClientProvider>
+      </I18nextProvider>
+    )
+    const source = await screen.findByRole('link', {
+      name: 'DSH modified source',
+    })
+    expect(source.getAttribute('href')).toMatch(
+      /^https:\/\/github\.com\/ahdg6\/newapi\/releases(?:\/tag\/[A-Za-z0-9._-]+)?$/
+    )
+    expect(source).toHaveAttribute('rel', 'noopener noreferrer')
+    expect(screen.getAllByRole('link', { name: 'New API' })).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          href: 'https://github.com/QuantumNous/new-api',
+        }),
+      ])
+    )
+    await act(async () => {
+      await i18n.changeLanguage('zh')
+    })
+    expect(screen.getByRole('link', { name: 'DSH 修改版源码' })).toBeVisible()
+    client.clear()
+  }
+)
